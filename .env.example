# All inference runs locally. No paid API keys are accepted.
TRACE_MODEL=qwen3:4b
# demo: the synthetic dataset from `make demo-data` (about 9k transactions).
# full: the benchmark from scripts/download_data.py (590k transactions).
TRACE_DATASET=demo
# Optional local data directory override:
# TRACE_DATA_DIR=/absolute/path/to/data

# TigerGraph Community Edition running locally in Docker. Free for production,
# research and educational use. No cloud account and no billing.
#   docker run -d --platform linux/amd64 --name tigergraph \
#     --ulimit nofile=1000000:1000000 \
#     -p 14022:22 -p 9000:9000 -p 14240:14240 tigergraph/community:4.2.5
# These are Community Edition's default credentials on a loopback-only container.
# Change them, and keep this file out of Git, if the instance is reachable from
# anywhere else.
TG_MCP_URL=http://127.0.0.1:9001/mcp
TG_GRAPH=Trace
TG_GRAPHNAME=Trace
TG_HOST=http://127.0.0.1
TG_RESTPP_PORT=9000
TG_GS_PORT=14240
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph

# For TigerGraph Savanna instead, clear TG_USERNAME/TG_PASSWORD and set:
# TG_HOST=https://<your-workspace>.i.tgcloud.io
# TG_API_TOKEN=<token>

# Set to "" to stop scripts/run_benchmark.py restarting the local container's
# services when a Community Edition service is killed under load.
TG_LOCAL_CONTAINER=tigergraph
